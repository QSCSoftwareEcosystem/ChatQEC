# =============================================================================
# ChatQEC .gitignore
# =============================================================================
# Keep tracked: source code, configs, knowledge/, sources/registry.jsonl,
# sources/watchlist.yaml, /plan/, /docs/, tests/, fixtures, pyproject.toml,
# uv.lock, README, LICENSE, CHANGELOG, .github/workflows.
# =============================================================================

# -----------------------------------------------------------------------------
# AI coding assistant footprint (local tool state, not project artifacts)
# -----------------------------------------------------------------------------
.claude/
.claude-code-router/
CLAUDE.local.md
GEMINI.local.md
AGENTS.local.md
.codex/
.aider*
.continue/
.cursor/
.windsurfrules

# Transcripts and tool output paths Claude may write into the repo
.claude_transcripts/
.claude_sessions/
*.claude.log

# -----------------------------------------------------------------------------
# Project temp / scratch (per CLAUDE.md convention)
# -----------------------------------------------------------------------------
temp/
tmp/
scratch/
.tmp/

# -----------------------------------------------------------------------------
# Private/unreviewed planning docs (not for shared repo history yet)
# -----------------------------------------------------------------------------
docs/planning/plans/private/

# Private meeting-prep notes (personal reference, not for shared repo history)
docs/meeting-prep/

# Image-generation prompt briefs (may reference internal/colleague work, not for shared repo history)
docs/images/*_prompt.md

# Local scratch clone (nested repo, not part of ChatQEC)
6aa18649dac0c24b522cc5e3/

