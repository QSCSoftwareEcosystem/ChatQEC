# Local-only API status helper (contains no secrets, but keep out of git)
scripts/check_api_status.sh

# Local book PDFs (copyrighted personal copies — never commit)
Raw/

# Generated corpus statistics
data/corpus_stats.json
snapshots/

# NAACL demo paper (separate Overleaf git repo) and slide decks
6ac52ba22379cb285b6dc6d7/
*.pptx

# Benchmark checkouts and generated gold (pinned in eval/benchmarks/pins.yaml)
data/benchmarks/

# Benchmark smoke runs (paper runs in eval/results/ are committed)
eval/results/smoke/

# Benchmark run files are written while a run is in progress. A commit's pre-commit hook
# stashes unstaged changes to tracked files, which silently drops rows a running job appends
# (lost 26 rows on 2026-11-05). Keep them untracked; commit a finished run with `git add -f`.
eval/results/**/*.jsonl

# Raw frontier-LLM chat exports (curated copies live in eval/compare/transcripts/)
Frontier_LLM_output/
